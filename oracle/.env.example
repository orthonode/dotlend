# DotLend Oracle — environment variables
# Copy to .env and fill in values. Never commit .env.

# Required
PRIVATE_KEY=0xyour_deployer_private_key_here

# Optional overrides — defaults shown are the deployed testnet addresses
# PRICE_ORACLE_ADDRESS=0x1282F6B59869a57Fd2a1D7a5BC8535bB7B15D173
# VDOT_ADDRESS=0xfc1ACa9EDF5DA2eBEA5CE1320fb40A74Ac996544
